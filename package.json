{
  "name": "pku-3d",
  "version": "1.5.6",
  "private": true,
  "description": "Interactive 3D model of Peking University, built with GPT-6 Astra using publicly available data",
  "scripts": {
    "setup": "python3 scripts/assets.py setup",
    "dev": "python3 scripts/serve.py",
    "dev:references": "python3 scripts/serve.py --references",
    "build": "python3 app/build.py --cached",
    "build:scene": "python3 app/build.py",
    "assets:pack": "python3 scripts/assets.py pack",
    "test": "node scripts/test.cjs",
    "deploy": "python3 scripts/publish.py",
    "audit:entrances": "node app/tools/audit-entrance-renderers.cjs",
    "test:shadow": "node app/tools/check-shadow-receiver.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sldyns/PKU-3D.git"
  },
  "homepage": "https://sldyns.github.io/PKU-3D/"
}
